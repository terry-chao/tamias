<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework / Nullable / ImplicitUsings / LangVersion 继承根目录的
       Directory.Build.props（net8.0）。这里只写本工程特有的。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 原生 tamias_server.dll 是 x64。AnyCPU 在 32 位宿主里跑会直接 BadImageFormat。 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Tamias.Server</AssemblyName>
    <RootNamespace>Tamias.Server</RootNamespace>
    <!-- 服务壳不做本地化；省掉 ICU 依赖，容器镜像更小。 -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- 刻意**不**引用 Tamias.Api / Tamias.Host：
       那两个是「C++ 宿主装 .NET 插件」那半边的东西，服务端是反方向（.NET 装 C++）。
       服务壳只认 src/server/server_api.h 这一个契约。 -->

</Project>
