{
  "name": "tamias",
  "version": "0.1.0",
  "builtin-baseline": "616affa24b974b710a4fc26257e90b7fda6d6826",
  "overrides": [
    {
      "name": "opencascade",
      "version": "7.9.3"
    }
  ],
  "features": {
    "linux-desktop": {
      "description": "Linux X11/XCB Qt and Vulkan platform dependencies",
      "supports": "linux",
      "dependencies": [
        {
          "name": "vulkan-loader",
          "default-features": false,
          "features": ["xcb"]
        },
        {
          "name": "qtbase",
          "default-features": false,
          "features": ["fontconfig", "freetype", "xcb"]
        }
      ]
    }
  },
  "dependencies": [
    {
      "name": "opencascade",
      "default-features": false,
      "features": ["freetype"]
    },
    {
      "name": "vulkan",
      "platform": "linux"
    },
    {
      "name": "vulkan-memory-allocator",
      "platform": "linux"
    },
    {
      "name": "xcb",
      "platform": "linux"
    },
    {
      "name": "fastgltf",
      "platform": "linux"
    },
    {
      "name": "rapidobj",
      "platform": "linux"
    },
    {
      "name": "spdlog",
      "platform": "linux",
      "default-features": false
    },
    {
      "name": "gtest",
      "platform": "linux"
    },
    {
      "name": "qtbase",
      "platform": "linux",
      "default-features": false,
      "features": ["gui", "widgets", "png"]
    },
    {
      "name": "qtsvg",
      "platform": "linux"
    },
    {
      "name": "glslang",
      "platform": "linux",
      "features": ["tools"]
    }
  ]
}
