    "fastgltf",
    "rapidobj",
    {
      "name": "spdlog",
      "default-features": false
    },
    "gtest",
    {
      "name": "qtbase",
      "default-features": false,
      "features": ["gui", "widgets", "png"]
    },
    "qtsvg",
    {
      "name": "glslang",
      "features": ["tools"]
    }
  ]
