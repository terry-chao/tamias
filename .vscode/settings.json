{
  "cmake.useCMakePresets": "always",
  "cmake.useVsDeveloperEnvironment": "always",
  "cmake.configureOnOpen": true,
  "cmake.configurePreset": "msvc",
  "cmake.buildPreset": "debug",
  "cmake.buildBeforeRun": true,
  "cmake.saveBeforeBuild": true,
  "cmake.debugConfig": {
    "type": "cppvsdbg",
    "preLaunchTask": "Tamias: 编译",
    "preRestartTask": "Tamias: 编译",
    "logging": {
      "exceptions": false
    }
  },
  "cmake.outputLogEncoding": "auto",
  "cmake.environment": {
    "VSLANG": "1033",
    "PreferredUILang": "en-US",
    "VCPKG_ROOT": "D:\\dev\\vcpkg",
    "VCPKG_INSTALLATION_ROOT": "D:\\dev\\vcpkg",
    "HTTP_PROXY": "http://127.0.0.1:7897",
    "HTTPS_PROXY": "http://127.0.0.1:7897"
  },
  "cmake.buildEnvironment": {
    "VSLANG": "1033",
    "PreferredUILang": "en-US"
  },
  "terminal.integrated.env.windows": {
    "PATH": "D:\\dev\\emsdk;D:\\dev\\emsdk\\upstream\\emscripten;${env:PATH}"
  },

  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.intelliSenseMode": "windows-msvc-x64",
  "C_Cpp.default.cppStandard": "c++23",
  "dotnet.preferCSharpExtension": true,
  "dotnet.defaultSolution": "disable"
}
