{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC x64 (system Qt + FetchContent)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64",
        "TAMIAS_ENABLE_OPENGL_BACKEND": "ON",
        "TAMIAS_USE_FETCHCONTENT": "ON"
      }
    },
    {
      "name": "msvc-ninja",
      "displayName": "MSVC x64 Ninja (compile_commands for clangd)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "TAMIAS_ENABLE_OPENGL_BACKEND": "ON",
        "TAMIAS_USE_FETCHCONTENT": "ON",
        "TAMIAS_CLANGD_RAPIDOBJ_STUB": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux x64 (Vulkan, X11/XCB)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "toolchainFile": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TAMIAS_ENABLE_OPENGL_BACKEND": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_FEATURES": "linux-desktop"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "msvc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "linux-relwithdebinfo",
      "configurePreset": "linux"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-relwithdebinfo",
      "configurePreset": "msvc",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-relwithdebinfo",
      "configurePreset": "linux",
      "output": { "outputOnFailure": true }
    }
  ]
}
